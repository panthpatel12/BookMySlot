@model BookMySlot.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient p-4 text-center text-white" style="background: linear-gradient(135deg, #091b30 0%, #0f2a4a 100%);">
                    <i class="bi bi-person-lock fs-1 text-teal-light mb-2"></i>
                    <h3 class="fw-bold mb-1">Welcome Back</h3>
                    <p class="text-light text-opacity-75 small mb-0">Sign in to manage your appointments and schedule</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus autocomplete="username" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-key"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-bms-primary w-100 py-2 fs-6 shadow-sm mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </button>

                        <div class="text-center small text-muted">
                            Don't have an account? 
                            <a asp-action="Register" class="text-decoration-none fw-semibold" style="color: var(--bms-teal);">Create a Customer Account</a>
                        </div>
                    </form>

                    <!-- One-Click Academic Demo Login Buttons -->
                    <div class="mt-4 p-3 bg-light rounded-3 border text-center">
                        <div class="fw-bold text-dark mb-2 small d-flex align-items-center justify-content-center gap-1">
                            <i class="bi bi-lightning-charge-fill text-warning"></i>
                            <span>One-Click Academic Demo Login</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2 justify-content-center">
                            <form asp-action="QuickLogin" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="role" value="Admin" />
                                <button type="submit" class="btn btn-sm btn-bms-primary">
                                    <i class="bi bi-shield-lock me-1"></i>Admin
                                </button>
                            </form>
                            <form asp-action="QuickLogin" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="role" value="Provider" />
                                <button type="submit" class="btn btn-sm btn-bms-teal">
                                    <i class="bi bi-person-badge me-1"></i>Provider
                                </button>
                            </form>
                            <form asp-action="QuickLogin" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="role" value="Customer" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-person me-1"></i>Customer
                                </button>
                            </form>
                        </div>
                        <div class="small text-muted mt-2" style="font-size: 0.75rem;">
                            Manual password for all demo accounts: <code>Admin123!</code> / <code>User@12345</code>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
