@model BookMySlot.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Customer Registration";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-gradient p-4 text-center text-white" style="background: linear-gradient(135deg, #091b30 0%, #0d9488 100%);">
                    <i class="bi bi-person-plus-fill fs-1 text-light mb-2"></i>
                    <h3 class="fw-bold mb-1">Create Account</h3>
                    <p class="text-light text-opacity-75 small mb-0">Join BookMySlot to book appointments effortlessly</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <div class="alert alert-info py-2 px-3 small mb-3 d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill"></i>
                        <span>Public registration automatically registers you as a <strong>Customer</strong>.</span>
                    </div>

                    <form asp-action="Register" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" autofocus />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="username" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-lock-fill"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter your password" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-bms-teal w-100 py-2 fs-6 shadow-sm mb-3">
                            <i class="bi bi-check2-circle me-2"></i>Complete Registration
                        </button>

                        <div class="text-center small text-muted">
                            Already registered? 
                            <a asp-action="Login" class="text-decoration-none fw-semibold" style="color: var(--bms-navy);">Sign In Here</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
