@model IReadOnlyList<BookMySlot.Models.Service>
@{
    ViewData["Title"] = "Service Catalogue";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Our Service Catalogue</h2>
            <p class="text-muted small mb-0">Browse through our specialized consulting and support services.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Back to Home
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var s in Model)
        {
            <div class="col">
                <div class="service-card shadow-sm h-100">
                    <div class="service-card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-teal-soft text-teal fw-semibold rounded-pill px-3 py-1">
                                <i class="bi bi-clock me-1"></i>@s.DurationMinutes Mins
                            </span>
                            <span class="service-price">₹@s.Price.ToString("N0")</span>
                        </div>
                        <h4 class="fw-bold text-dark mt-2 mb-2">@s.Name</h4>
                        <p class="text-muted small flex-grow-1 mb-4">@s.Description</p>
                        <div class="pt-3 border-top mt-auto">
                            <a asp-controller="Home" asp-action="ServiceDetails" asp-route-id="@s.Id" class="btn btn-bms-teal w-100 fw-semibold">
                                View Slots & Specialists <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
