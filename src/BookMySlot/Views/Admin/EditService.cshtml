@model BookMySlot.ViewModels.Admin.ServiceFormViewModel
@{
    ViewData["Title"] = $"Edit Service - {Model.Name}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header p-4 text-white" style="background: linear-gradient(135deg, #091b30 0%, #0f2a4a 100%);">
                    <span class="badge bg-light text-dark px-2 py-1 rounded-pill small mb-1">Service ID: #@Model.Id</span>
                    <h3 class="fw-bold mb-1">Edit Service</h3>
                    <p class="text-light text-opacity-80 small mb-0">Update service attributes, duration, or fees.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="EditService" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="Name" class="form-control" autofocus />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold text-secondary small"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="DurationMinutes" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <input asp-for="DurationMinutes" type="number" class="form-control" min="5" max="480" step="5" />
                                    <span class="input-group-text bg-light">mins</span>
                                </div>
                                <span asp-validation-for="DurationMinutes" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold text-secondary small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light">₹</span>
                                    <input asp-for="Price" type="number" class="form-control" min="0" step="50" />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-semibold small text-secondary"></label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Services" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-bms-primary px-4 py-2 fw-semibold">
                                <i class="bi bi-save me-1"></i>Update Service
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
