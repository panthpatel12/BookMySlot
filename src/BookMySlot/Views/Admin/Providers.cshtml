@model List<BookMySlot.Models.ProviderProfile>
@{
    ViewData["Title"] = "Manage Providers";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Service Providers Management</h2>
            <p class="text-muted small mb-0">Manage provider credentials, specializations, and service assignments.</p>
        </div>
        <a asp-action="CreateProvider" class="btn btn-bms-teal shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i>Create New Provider
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 table-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Specialist Name</th>
                            <th>Contact Email</th>
                            <th>Bio / Credentials</th>
                            <th>Assigned Services</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@p.User.FullName</div>
                                </td>
                                <td>
                                    <div class="small text-secondary">@p.User.Email</div>
                                </td>
                                <td>
                                    <div class="small text-muted" style="max-width: 320px;">
                                        @(string.IsNullOrWhiteSpace(p.Bio) ? "No bio provided" : p.Bio)
                                    </div>
                                </td>
                                <td>
                                    @if (p.ProviderServices.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var ps in p.ProviderServices)
                                            {
                                                <span class="badge bg-light text-dark border small">@ps.Service.Name</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-danger small"><i class="bi bi-exclamation-circle me-1"></i>None</span>
                                    }
                                </td>
                                <td>
                                    @if (p.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="ManageProvider" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary" title="Manage Services & Profile">
                                            <i class="bi bi-sliders"></i> Assignments
                                        </a>
                                        <form asp-action="ToggleProviderStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            @if (p.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning text-dark" title="Deactivate Provider">
                                                    <i class="bi bi-pause-circle"></i> Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Activate Provider">
                                                    <i class="bi bi-play-circle"></i> Activate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
