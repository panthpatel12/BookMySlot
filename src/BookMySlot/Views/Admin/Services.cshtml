@model List<BookMySlot.Models.Service>
@{
    ViewData["Title"] = "Manage Services";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Services Management</h2>
            <p class="text-muted small mb-0">Create, configure, and maintain service offerings.</p>
        </div>
        <a asp-action="CreateService" class="btn btn-bms-teal shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>Add New Service
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 table-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Service Name</th>
                            <th>Description</th>
                            <th>Duration</th>
                            <th>Standard Price</th>
                            <th>Assigned Providers</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark">@s.Name</div>
                                </td>
                                <td>
                                    <div class="small text-muted" style="max-width: 340px;">@s.Description</div>
                                </td>
                                <td>@s.DurationMinutes Mins</td>
                                <td><span class="fw-bold text-teal">₹@s.Price.ToString("N0")</span></td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @s.ProviderServices.Count Specialist(s)
                                    </span>
                                </td>
                                <td>
                                    @if (s.IsActive)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1">
                                            Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="EditService" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Edit Service">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleServiceStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            @if (s.IsActive)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning text-dark" title="Deactivate Service">
                                                    <i class="bi bi-pause-circle"></i> Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Activate Service">
                                                    <i class="bi bi-play-circle"></i> Activate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
