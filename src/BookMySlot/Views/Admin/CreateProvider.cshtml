@model BookMySlot.ViewModels.Admin.CreateProviderViewModel
@{
    ViewData["Title"] = "Create Provider Account";
    var services = ViewBag.Services as List<BookMySlot.Models.Service> ?? new List<BookMySlot.Models.Service>();
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header p-4 text-white" style="background: linear-gradient(135deg, #091b30 0%, #0f2a4a 100%);">
                    <h3 class="fw-bold mb-1">Create Service Provider</h3>
                    <p class="text-light text-opacity-80 small mb-0">Register a new specialist account and assign initial services.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="CreateProvider" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="FullName" class="form-control" placeholder="e.g. Dr. Rajesh Sharma" autofocus />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="Email" class="form-control" placeholder="provider@bookmyslot.local" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="InitialPassword" class="form-label fw-semibold text-secondary small"></label>
                            <input asp-for="InitialPassword" class="form-control" />
                            <span asp-validation-for="InitialPassword" class="text-danger small"></span>
                            <div class="form-text small text-muted">
                                <i class="bi bi-shield-lock me-1"></i>Hashed securely using ASP.NET Core Identity PBKDF2 with HMAC-SHA256. Not stored in plain text.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label fw-semibold text-secondary small"></label>
                            <textarea asp-for="Bio" class="form-control" rows="3" 
                                      placeholder="Brief summary of professional credentials, qualifications, and domain expertise..."></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Assign Active Services</label>
                            <div class="row g-2">
                                @foreach (var s in services)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check p-2 bg-light rounded-3 border">
                                            <input class="form-check-input ms-1" type="checkbox" name="SelectedServiceIds" value="@s.Id" id="srv_@s.Id" />
                                            <label class="form-check-label ms-2 small fw-semibold" for="srv_@s.Id">
                                                @s.Name (@s.DurationMinutes m - ₹@s.Price.ToString("N0"))
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Providers" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-bms-primary px-4 py-2 fw-semibold">
                                <i class="bi bi-check-circle me-1"></i>Create Provider
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
