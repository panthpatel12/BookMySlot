@model BookMySlot.ViewModels.Home.ServiceDetailViewModel
@{
    ViewData["Title"] = $"{Model.Service.Name} - Service Details";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Services" asp-action="Index">Services</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Service.Name</li>
        </ol>
    </nav>

    <!-- Service Header Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="p-4 p-md-5 text-white" style="background: linear-gradient(135deg, #091b30 0%, #0f2a4a 60%, #0d9488 100%);">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-light text-dark px-3 py-1 rounded-pill mb-2 fw-semibold">
                        <i class="bi bi-clock me-1"></i>@Model.Service.DurationMinutes Minutes
                    </span>
                    <h1 class="fw-bold mb-3">@Model.Service.Name</h1>
                    <p class="lead text-light text-opacity-90 mb-0">@Model.Service.Description</p>
                </div>
                <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">
                    <div class="bg-white bg-opacity-10 p-3 rounded-4 d-inline-block text-center border border-white border-opacity-25">
                        <div class="small text-light text-opacity-75 text-uppercase fw-semibold">Standard Fee</div>
                        <div class="display-6 fw-bold text-white">₹@Model.Service.Price.ToString("N0")</div>
                        <div class="small text-info"><i class="bi bi-shield-check me-1"></i>Instant Confirmation</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Assigned Providers Column -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h4 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                    <i class="bi bi-people text-teal"></i>
                    <span>Assigned Specialists</span>
                </h4>
                @if (Model.AssignedProviders.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var provider in Model.AssignedProviders)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <h6 class="fw-bold text-dark mb-1 d-flex align-items-center gap-2">
                                    <i class="bi bi-person-check-fill text-primary"></i>
                                    <span>@provider.Name</span>
                                </h6>
                                <p class="text-muted small mb-0">@provider.Bio</p>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No providers are currently assigned to this service.</p>
                }
            </div>
        </div>

        <!-- Available Slots Column -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-calendar-week text-teal"></i>
                        <span>Upcoming Available Slots</span>
                    </h4>
                    <span class="badge bg-light text-secondary border">
                        <i class="bi bi-globe me-1"></i>@Model.TimeZoneDisplayName
                    </span>
                </div>

                @if (Model.AvailableSlots.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        @foreach (var slot in Model.AvailableSlots)
                        {
                            <div class="col">
                                <div class="card p-3 rounded-3 border slot-card available h-100 d-flex flex-column justify-content-between">
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2 py-1 small">
                                                Available
                                            </span>
                                            <span class="fw-bold text-primary">₹@slot.Price.ToString("N0")</span>
                                        </div>
                                        <div class="fw-semibold text-dark mb-1">
                                            <i class="bi bi-calendar3 me-1 text-teal"></i>@slot.FormattedDate
                                        </div>
                                        <div class="small text-muted mb-2">
                                            <i class="bi bi-clock me-1 text-teal"></i>@slot.FormattedTime
                                        </div>
                                        <div class="small text-secondary mb-3">
                                            <i class="bi bi-person me-1"></i>@slot.ProviderName
                                        </div>
                                    </div>

                                    @if (User.IsInRole("Customer"))
                                    {
                                        <a asp-controller="Customer" asp-action="Book" asp-route-slotId="@slot.SlotId" class="btn btn-sm btn-bms-teal w-100 fw-semibold">
                                            <i class="bi bi-lightning-charge me-1"></i>Book Now
                                        </a>
                                    }
                                    else if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary w-100 disabled">Available</button>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Book", "Customer", new { slotId = slot.SlotId })" class="btn btn-sm btn-bms-primary w-100 fw-semibold">
                                            Sign In to Book
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x text-muted fs-1 mb-2"></i>
                        <p class="text-muted small mb-0">No available future slots found for this service at the moment.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
