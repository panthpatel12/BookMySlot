@{
    ViewData["Title"] = "Privacy Policy";
}
<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <h2 class="fw-bold text-dark mb-3">Privacy & Security Commitment</h2>
        <p class="text-secondary lead">
            BookMySlot is built with academic and professional best practices to ensure user confidentiality and scheduling integrity.
        </p>
        <hr class="my-4" />
        <h5 class="fw-bold text-dark">Data Protection & Credentials</h5>
        <p class="text-muted small">
            All user credentials, passwords, and sensitive information are cryptographically hashed using industry-standard ASP.NET Core Identity PBKDF2 hashing. Passwords are never stored or transmitted in plain text.
        </p>
        <h5 class="fw-bold text-dark mt-4">Session & Concurrency Integrity</h5>
        <p class="text-muted small">
            Slots are protected by strict relational database constraints preventing duplicate or overlapping bookings across concurrent requests.
        </p>
    </div>
</div>
