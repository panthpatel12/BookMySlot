@model BookMySlot.ViewModels.Home.HomeIndexViewModel
@{
    ViewData["Title"] = "Appointment Booking System";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start mb-4 mb-lg-0">
                <span class="badge bg-teal-subtle text-info px-3 py-2 rounded-pill fw-semibold mb-3 border border-info border-opacity-25">
                    <i class="bi bi-patch-check-fill me-1"></i>Reliable & Instant Scheduling
                </span>
                <h1 class="hero-title mb-3">Book Appointments Seamlessly Without Phone Calls</h1>
                <p class="hero-subtitle mb-4">
                    Explore available slots in real-time, connect with expert service providers, and manage your schedules with zero conflicts and zero double-booking.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="#browse-slots" class="btn btn-bms-teal btn-lg shadow-sm">
                        <i class="bi bi-calendar-check me-2"></i>Find & Book a Slot
                    </a>
                    <a asp-controller="Services" asp-action="Index" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-grid-fill me-2"></i>Browse Services
                    </a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="stat-card">
                            <div class="stat-icon teal">
                                <i class="bi bi-people-fill"></i>
                            </div>
                            <div>
                                <div class="stat-value">@Model.TotalProvidersCount</div>
                                <div class="stat-label">Providers</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="stat-card">
                            <div class="stat-icon primary">
                                <i class="bi bi-briefcase-fill"></i>
                            </div>
                            <div>
                                <div class="stat-value">@Model.TotalServicesCount</div>
                                <div class="stat-label">Services</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="stat-card">
                            <div class="stat-icon success">
                                <i class="bi bi-check-all"></i>
                            </div>
                            <div>
                                <div class="stat-value">@Model.TotalBookingsCount+</div>
                                <div class="stat-label">Verified Appointments Booked</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Filter & Available Slots Section -->
<section id="browse-slots" class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Available Appointment Slots</h2>
            <p class="text-muted small mb-0">
                Genuinely open slots with real-time slot reservation protection. All times in 
                <span class="badge bg-light text-dark border">@Model.TimeZoneDisplayName</span>
            </p>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary">Service</label>
                <select name="serviceId" class="form-select" asp-items="Model.ServicesList">
                    <option value="">-- All Active Services --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Service Provider</label>
                <select name="providerId" class="form-select" asp-items="Model.ProvidersList">
                    <option value="">-- All Providers --</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Date</label>
                <input type="date" name="date" class="form-control" 
                       value="@(Model.SelectedDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-bms-primary w-100">
                    <i class="bi bi-search me-1"></i>Filter
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- Slots Grid -->
    @if (Model.AvailableSlots.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var slot in Model.AvailableSlots)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 slot-card available">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                                <i class="bi bi-check-circle me-1"></i>Open Slot
                            </span>
                            <span class="fw-bold text-teal fs-5" style="color: var(--bms-teal);">₹@slot.Price.ToString("N0")</span>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">@slot.ServiceName</h5>
                        <p class="text-secondary small mb-3">
                            <i class="bi bi-person-badge me-1 text-primary"></i><strong>Provider:</strong> @slot.ProviderName
                        </p>
                        
                        <div class="p-2 bg-light rounded-3 mb-3 small">
                            <div class="text-dark fw-semibold mb-1">
                                <i class="bi bi-calendar3 me-1 text-teal"></i>@slot.FormattedDate
                            </div>
                            <div class="text-muted">
                                <i class="bi bi-clock me-1 text-teal"></i>@slot.FormattedTime 
                                <span class="badge bg-secondary bg-opacity-25 text-dark ms-1">@slot.DurationMinutes mins</span>
                            </div>
                        </div>

                        <div class="mt-auto">
                            @if (User.IsInRole("Customer"))
                            {
                                <a asp-controller="Customer" asp-action="Book" asp-route-slotId="@slot.SlotId" 
                                   class="btn btn-bms-teal w-100 fw-semibold">
                                    <i class="bi bi-lightning-charge-fill me-1"></i>Book This Slot
                                </a>
                            }
                            else if (User.Identity?.IsAuthenticated == true)
                            {
                                <button class="btn btn-outline-secondary w-100 disabled" title="Signed in as Provider or Admin">
                                    <i class="bi bi-info-circle me-1"></i>Available
                                </button>
                            }
                            else
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Book", "Customer", new { slotId = slot.SlotId })" 
                                   class="btn btn-bms-primary w-100 fw-semibold">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Sign In to Book
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
            <div class="text-muted mb-3">
                <i class="bi bi-calendar-x" style="font-size: 3.5rem;"></i>
            </div>
            <h4 class="fw-bold text-dark">No Available Slots Found</h4>
            <p class="text-muted small mb-3">There are no upcoming slots matching your selected filter criteria.</p>
            <div>
                <a asp-action="Index" class="btn btn-bms-outline-teal btn-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reset All Filters
                </a>
            </div>
        </div>
    }
</section>

<!-- Featured Services Section -->
<section class="bg-light py-5 border-top">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2 rounded-pill fw-semibold mb-2">Our Offerings</span>
            <h2 class="fw-bold text-dark">Services We Provide</h2>
            <p class="text-muted">Expert assistance tailored to your personal and professional needs.</p>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            @foreach (var s in Model.FeaturedServices)
            {
                <div class="col">
                    <div class="service-card shadow-sm">
                        <div class="service-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-teal-soft text-teal fw-semibold rounded-pill px-2 py-1">
                                    @s.DurationMinutes Mins
                                </span>
                                <span class="service-price">₹@s.Price.ToString("N0")</span>
                            </div>
                            <h5 class="fw-bold text-dark mt-2 mb-2">@s.Name</h5>
                            <p class="text-muted small mb-4" style="line-height: 1.5;">@s.Description</p>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 pb-3 px-3">
                            <a asp-action="ServiceDetails" asp-route-id="@s.Id" class="btn btn-bms-outline-teal w-100 btn-sm">
                                View Details & Slots <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
