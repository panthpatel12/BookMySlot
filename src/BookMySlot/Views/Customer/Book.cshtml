@model BookMySlot.ViewModels.Customer.BookAppointmentViewModel
@{
    ViewData["Title"] = $"Confirm Booking - {Model.ServiceName}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header p-4 text-white" style="background: linear-gradient(135deg, #091b30 0%, #0d9488 100%);">
                    <span class="badge bg-light text-dark px-3 py-1 rounded-pill small mb-2 fw-semibold">
                        Step: Confirm & Reserve Slot
                    </span>
                    <h2 class="fw-bold mb-1">Book Your Appointment</h2>
                    <p class="text-light text-opacity-80 small mb-0">Review details before securing your slot reservation.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Service Summary Card -->
                    <div class="p-3 bg-light rounded-3 border mb-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h4 class="fw-bold text-dark mb-1">@Model.ServiceName</h4>
                                <div class="text-muted small">@Model.ServiceDescription</div>
                            </div>
                            <span class="fs-4 fw-bold text-teal" style="color: var(--bms-teal);">₹@Model.Price.ToString("N0")</span>
                        </div>
                        <hr class="my-2" />
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <span class="text-muted"><i class="bi bi-person-badge text-primary me-1"></i>Specialist:</span>
                                <strong>@Model.ProviderName</strong>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted"><i class="bi bi-clock text-teal me-1"></i>Duration:</span>
                                <strong>@Model.DurationMinutes Minutes</strong>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted"><i class="bi bi-calendar-event text-danger me-1"></i>Slot Schedule:</span>
                                <span class="badge bg-white text-dark border px-2 py-1 fs-6">@Model.FormattedSchedule</span>
                            </div>
                            <div class="col-12 text-muted" style="font-size: 0.78rem;">
                                <i class="bi bi-globe me-1"></i>All times presented in: @Model.TimeZoneDisplayName
                            </div>
                        </div>
                    </div>

                    <!-- Booking Form -->
                    <form asp-action="Book" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SlotId" />

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold text-secondary small"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" 
                                      placeholder="Briefly state your purpose, questions, or specific topics for this session..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-warning py-2 small mb-4 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-exclamation fs-5"></i>
                            <div>
                                Once confirmed, the system will lock this slot exclusively for you. You may cancel or reschedule any time before the session starts.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </a>
                            <button type="submit" class="btn btn-bms-teal px-4 py-2 fw-semibold shadow-sm">
                                <i class="bi bi-check-circle-fill me-2"></i>Confirm & Secure Slot
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
